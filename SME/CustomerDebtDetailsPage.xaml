<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SME.CustomerDebtDetailsPage"
             Title="Customer Details"
             BackgroundImageSource="background.png"
             BackgroundColor="#0B0033">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Customer Name -->
            <Label x:Name="CustomerNameLabel"
                   Text="Customer Name"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- Total Debt -->
            <Label x:Name="TotalAmountLabel"
                   Text="₱0.00"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- Debt Details List -->
            <CollectionView x:Name="DebtListView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#1D1557"
                               CornerRadius="15"
                               Padding="16"
                               Margin="0,10"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="6">

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding credit_date}" TextColor="White" FontSize="14" Grid.Column="0"/>
                                    <Label Text="{Binding due_date}" TextColor="White" FontSize="14" HorizontalOptions="End" Grid.Column="1"/>
                                </Grid>

                                <Label Text="{Binding amount_display}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="{Binding product_summary}" TextColor="White" FontSize="13"/>

                                <Button Text="Add Payment"
                                        IsVisible="{Binding show_add_payment}"
                                        BackgroundColor="#2979FF"
                                        TextColor="White"
                                        CornerRadius="10"
                                        FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
