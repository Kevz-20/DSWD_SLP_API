<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="SME.FinancialReportPage"
             Title="Financial Report"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="background.png"
               Aspect="AspectFill"
               Opacity="1"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand" />

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="📊 Financial Report"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <DatePicker x:Name="StartDatePicker"
                                IsVisible="False"
                                DateSelected="StartDatePicker_DateSelected"
                                Date="{x:Static sys:DateTime.Now}" />

                    <Button x:Name="StartDateButton"
                            Text="📅 Start Date"
                            BackgroundColor="#4B3B88"
                            TextColor="White"
                            Clicked="OnStartDateClicked" />

                    <DatePicker x:Name="EndDatePicker"
                                IsVisible="False"
                                DateSelected="EndDatePicker_DateSelected"
                                Date="{x:Static sys:DateTime.Now}" />

                    <Button x:Name="EndDateButton"
                            Text="📅 End Date"
                            BackgroundColor="#4B3B88"
                            TextColor="White"
                            Clicked="OnEndDateClicked" />
                </HorizontalStackLayout>

                <Button Text="📄 Generate PDF"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontSize="18"
                        Clicked="OnGeneratePdfClicked" />

                <Grid ColumnDefinitions="*,*,*,*"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
                      Padding="10"
                      ColumnSpacing="10"
                      RowSpacing="8">

                    <Label Grid.Row="0" Grid.Column="0" Text="Metric" TextColor="Red" FontSize="18" HorizontalOptions="Center" />
                    <Label Grid.Row="0" Grid.Column="1" Text="This Period" TextColor="Red" FontSize="18" HorizontalOptions="Center" />
                    <Label Grid.Row="0" Grid.Column="2" Text="End Period" TextColor="Red" FontSize="18" HorizontalOptions="Center" />
                    <Label Grid.Row="0" Grid.Column="3" Text="% Change" TextColor="Red" FontSize="18" HorizontalOptions="Center" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Revenue" TextColor="White" />
                    <Label Grid.Row="1" Grid.Column="1" x:Name="RevenueThisPeriodLabel " TextColor="White" />
                    <Label Grid.Row="1" Grid.Column="2" x:Name="RevenueEndPeriodLabel" TextColor="White" />
                    <Label Grid.Row="1" Grid.Column="3" x:Name="RevenuePercentChangeLabel" TextColor="LightGreen" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Net Profit" TextColor="White" />
                    <Label Grid.Row="2" Grid.Column="1" x:Name="NetProfitThisPeriodLabel" TextColor="White" />
                    <Label Grid.Row="2" Grid.Column="2" x:Name="NetProfitEndPeriodLabel" TextColor="White" />
                    <Label Grid.Row="2" Grid.Column="3" x:Name="NetProfitPercentChangeLabel" TextColor="LightGreen" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Expenses" TextColor="White"/>
                    <Label Grid.Row="3" Grid.Column="1" x:Name="ExpensesThisPeriodLabel" TextColor="White" />
                    <Label Grid.Row="3" Grid.Column="2" x:Name="ExpensesEndPeriodLabel" TextColor="White" />
                    <Label Grid.Row="3" Grid.Column="3" x:Name="ExpensesPercentChangeLabel" TextColor="Red" />

                    <Label Grid.Row="4" Grid.Column="0" Text="Cost of Goods" TextColor="White" />
                    <Label Grid.Row="4" Grid.Column="1" x:Name="CostOfGoodsThisPeriodLabel" TextColor="White" />
                    <Label Grid.Row="4" Grid.Column="2" x:Name="CostOfGoodsEndPeriodLabel"  TextColor="White" />
                    <Label Grid.Row="4" Grid.Column="3" x:Name="CostOfGoodsPercentChangeLabel" TextColor="Red" />

                    <Label Grid.Row="5" Grid.Column="0" Text="Cash on Hand" TextColor="White" />
                    <Label Grid.Row="5" Grid.Column="1" x:Name="CashOnHandThisPeriodLabel" TextColor="White" />
                    <Label Grid.Row="5" Grid.Column="2" x:Name="CashOnHandEndPeriodLabel" TextColor="White" />
                    <Label Grid.Row="5" Grid.Column="3" x:Name="CashOnHandPercentChangeLabel" TextColor="LightGreen" />
                </Grid>

                <Frame BackgroundColor="#F9F9F9" CornerRadius="10" Padding="10" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="Bar Chart" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                        <ContentView x:Name="BarChartPlaceholder" HeightRequest="200" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#E8F5E9" CornerRadius="10" Padding="10" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="✅ Key Highlights" FontSize="20" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center"/>
                        <Label Text="• Net profit increased by 15%." FontSize="16" />
                        <Label Text="• Expenses were reduced by 10%." FontSize="16" />
                        <Label Text="• Revenue reached a new monthly high." FontSize="16" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#FFEBEE" CornerRadius="10" Padding="10" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="⚠️ Challenges" FontSize="20" FontAttributes="Bold" TextColor="#C62828" HorizontalOptions="Center"/>
                        <Label Text="• Inventory turnover slowed down." FontSize="16" />
                        <Label Text="• One supplier delayed delivery." FontSize="16" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
