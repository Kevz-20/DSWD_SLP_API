<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SME.DebtorsPage"
             Title="Debtors"
             BackgroundImageSource="background.png"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="20" Spacing="15">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Debtors"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White" />
            <ImageButton Source="plus.png"
                         WidthRequest="24"
                         HeightRequest="24"
                         BackgroundColor="Transparent"
                         Clicked="OnAddDebtorClicked" />
        </Grid>

        <!-- Search Box -->
        <Frame BackgroundColor="#130F4A" CornerRadius="10" Padding="10" HasShadow="False">
            <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                <Image Source="search.png"
                       WidthRequest="18"
                       HeightRequest="18"
                       VerticalOptions="Center"
                       Margin="0,0,10,0" />
                <Entry Placeholder="Search"
                       PlaceholderColor="#80FFFFFF"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       TextChanged="OnSearchTextChanged" />
            </Grid>
        </Frame>

        <!-- Customer List -->
        <CollectionView x:Name="CustomerListView"
                        ItemsSource="{Binding Customers}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#140E46"
                               CornerRadius="16"
                               Padding="15"
                               Margin="0,5"
                               HasShadow="True">
                        <VerticalStackLayout>
                            <Label Text="{Binding FullName}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                            <Label Text="{Binding ContactNumber, StringFormat='Contact Number: {0}'}" TextColor="#CCCCCC" FontSize="14"/>
                            <Label Text="{Binding Address, StringFormat='Address: {0}'}" TextColor="#CCCCCC" FontSize="14"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
