<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SME.ForgotPage"
             BackgroundColor="Black">
    <Grid>

        <Image Source="background.png"
           Aspect="AspectFill"
           Opacity="1"
           HorizontalOptions="FillAndExpand"
           VerticalOptions="FillAndExpand"/>

        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
            <Label Text="Forgot PIN"
                   FontSize="30"
                   FontAttributes="Italic"
                   HorizontalOptions="Center"
                   TextColor="White"
                   FontFamily="Arial" />

            <!-- Frame to apply border around Entry -->
            <Frame BorderColor="White"
                   CornerRadius="20"
                   BackgroundColor="Transparent"
                   Padding="20"
                   Margin="50">
                <Entry Placeholder="Enter your phone number"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       FontSize="20"
                       PlaceholderColor="White" />
            </Frame>

            <Frame BackgroundColor="Transparent" BorderColor="Transparent" Padding="0" CornerRadius="25">
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#106dff" Offset="0" />
                        <GradientStop Color="#106dff" Offset="1" />
                    </LinearGradientBrush>
                </Frame.Background>
                <Button Text="Submit"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    BackgroundColor="Transparent"
                    Clicked="OnSubmitClicked" />
            </Frame>

        </StackLayout>

    </Grid>
</ContentPage>
