<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SME.ManageInventoryPage"
             BackgroundImageSource="background.png"
             Title="Manage Inventory"
             Shell.NavBarIsVisible="False">

 

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,20" Spacing="20">

            <!-- Search Bar -->
            <Frame BackgroundColor="#060230" CornerRadius="10" Padding="1" HasShadow="False">
                <HorizontalStackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center" Spacing="10">

                    <!-- Search Icon -->
                    <Image Source="search.png"
                           WidthRequest="20"
                           HeightRequest="20"
                           VerticalOptions="Center"
                           Grid.Column="0"/>

                    <!-- Search Entry -->
                    <Entry Placeholder="Search"
                           PlaceholderColor="#A3A3A3"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           HorizontalOptions="Start"
                           TextChanged="OnSearchTextChanged" />

                    <!-- Filter Icon Button -->
                    <!-- <ImageButton Source="filter.png"
                     BackgroundColor="Transparent"
                     WidthRequest="24"
                     HeightRequest="24"
                     VerticalOptions="Center"
                     Grid.Column="2" /> -->
                </HorizontalStackLayout>
            </Frame>

            <!-- Inventory List -->
            <CollectionView x:Name="InventoryListView"
                            ItemsSource="{Binding InventoryItems}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#140E46"
                               CornerRadius="16"
                               Padding="15"
                               Margin="0,5"
                               HasShadow="True">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto,Auto">

                                <!-- Product Name -->
                                <Label Grid.Row="0" Grid.ColumnSpan="3"
                                       Text="{Binding ProductName}"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       Margin="0,0,0,5"/>

                                <!-- Stock -->
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Stock, StringFormat='In Stock: {0} pcs'}"
                                       TextColor="#CCCCCC"
                                       FontSize="13"/>

                                <!-- Low Stock Badge aligned below -->
                                <Frame Grid.Row="3" Grid.Column="1"
                                       BackgroundColor="Red"
                                       CornerRadius="8"
                                       Padding="4,2"
                                       IsVisible="{Binding IsLowStock}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Start">
                                    <Label Text="Low Stock"
                                           TextColor="White"
                                           FontSize="12"/>
                                </Frame>

                                <!-- Category -->
                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding Category}"
                                       FontSize="13"
                                       TextColor="#6780FF"
                                       FontAttributes="Bold"
                                       Margin="0,2,0,0"/>

                                <!-- Cost -->
                                <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Spacing="5">
                                    <Label Text="Price" TextColor="White" FontSize="13"/>
                                    <Label Text="{Binding SellingPrice, StringFormat='₱{0:F2}'}"
                                           TextColor="White" FontSize="13"
                                           FontAttributes="Bold"/>
                                </HorizontalStackLayout>



                                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                    HorizontalOptions="End"
                                                    Spacing="30"
                                                    VerticalOptions="Center">
                               <!-- Edit Icon -->
                                <ImageButton 
                                             Source="edit.png"
                                             BackgroundColor="Transparent"
                                             WidthRequest="24"
                                             HeightRequest="24"
                                             VerticalOptions="Center"
                                             Clicked="OnEditItemClicked"/>

                                <!-- Delete Icon -->
                                <ImageButton
                                             Source="delete.png"
                                             BackgroundColor="Transparent"
                                             WidthRequest="20"
                                             HeightRequest="20"
                                             VerticalOptions="Center"
                                             Clicked="OnDeleteItemClicked"/>
                             </HorizontalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
