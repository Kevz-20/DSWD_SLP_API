<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SME.CreateNewAccountPage"
             BackgroundColor="Black">

    <!-- Container Grid -->
    <Grid>
        <!-- Background Image -->
        <Image Source="background.png"
               Aspect="AspectFill"
               Opacity="1"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand"/>

        <!-- Page Content -->
        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
                <Label Text="Create New Account"
                       FontSize="24"
                       HorizontalOptions="Center"
                       TextColor="White"
                       Margin="0,20,0,0"/>

                <Entry x:Name="FirstNameEntry"
                       Placeholder="First Name"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       BackgroundColor="Transparent" />

                <Entry x:Name="MiddleNameEntry"
                       Placeholder="Middle Name"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       BackgroundColor="Transparent" />

                <Entry x:Name="LastNameEntry"
                       Placeholder="Last Name"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       BackgroundColor="Transparent" />

                <Entry x:Name="ContactEntry"
                       Placeholder="Contact Number"
                       Keyboard="Telephone"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       BackgroundColor="Transparent" />

                <Entry x:Name="PinEntry"
                       Placeholder="4-digit PIN"
                       IsPassword="True"
                       MaxLength="4"
                       Keyboard="Numeric"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       BackgroundColor="Transparent" />

                <Entry x:Name="ConfirmPinEntry"
                       Placeholder="Confirm 4-digit PIN"
                       IsPassword="True"
                       MaxLength="4"
                       Keyboard="Numeric"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       BackgroundColor="Transparent" />

                <Frame BackgroundColor="Transparent" BorderColor="Transparent" Padding="0" CornerRadius="25">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#106dff" Offset="0" />
                            <GradientStop Color="#106dff" Offset="1" />
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Button Text="Create Account"
                    FontSize="15"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Clicked="OnCreateAccountClicked" />
                </Frame>


                <Button Text="Back to Login"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="#21faff"
                        FontAttributes="Bold"
                        FontSize="14" />
            </VerticalStackLayout>
            
        </ScrollView>
    </Grid>

</ContentPage>
